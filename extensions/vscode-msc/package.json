{
  "name": "msc-dashboard",
  "displayName": "MSc Dashboard",
  "description": "Campaign-centered VS Code console for local PoggioAI/MSc research workflows.",
  "version": "0.1.0",
  "publisher": "poggio-ai",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:mscDashboard.open"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mscDashboard.open",
        "title": "MSc: Open Dashboard"
      }
    ]
  },
  "scripts": {
    "build": "vite build --config webview-ui/vite.config.mjs",
    "check": "node --check extension.js && node test/smoke.js",
    "test": "npm run build && npm run check"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
